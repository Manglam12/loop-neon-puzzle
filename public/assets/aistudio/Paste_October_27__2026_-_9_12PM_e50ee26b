func _new_puzzle() -> void:
    game_won = false
    moves = 0
    score = 0
    echo_cell = Vector2i(-1, -1)
    echo_countdown = 0
    board.clear()
    for y in range(BOARD_N):
        var row: Array = []
        for x in range(BOARD_N):
            row.append({"kind": "empty", "mask": 0, "solved": 0, "rotatable": false, "path": false})
        board.append(row)

    # Construct a known solvable path, then scramble each rotatable tile.
    for i in range(PATH.size()):
        var cell: Vector2i = PATH[i]
        var mask := _correct_mask_for_path(i)
        var kind := "corner"
        if i == 0:
            kind = "start"
        elif i == PATH.size() - 1:
            kind = "goal"
        elif mask == 5 or mask == 10:
            kind = "straight"
        board[cell.y][cell.x] = {
            "kind": kind,
            "mask": mask,
            "solved": mask,
            "rotatable": i != 0 and i != PATH.size() - 1,
            "path": true
        }

    # Ensure the initial board is not already solved. Deterministic per level,
    # with rotations that preserve the tile shape and always permit a solution.
    var rng := RandomNumberGenerator.new()
    rng.seed = 4317 + level * 997 + (0 if current_mode == "LEVELS" else score + moves + 91)
    for cell in PATH:
        var tile: Dictionary = board[cell.y][cell.x]
        if tile["rotatable"]:
            var turns := rng.randi_range(0, 3)
            if turns == 0:
                turns = 1 + (level % 3)
            tile["mask"] = _rotate_mask(int(tile["mask"]), turns)
            board[cell.y][cell.x] = tile

    _redraw_board()
    _update_labels()
    status_text.text = "Connect START to GOAL. Every move has an Echo."
    next_button.text = "NEXT PUZZLE  →" if current_mode == "LEVELS" else "NEW RUN  →"
    _check_win()

func _correct_mask_for_path(index: int) -> int:
    var cell: Vector2i = PATH[index]
    var mask := 0
    if index > 0:
        var prev: Vector2i = PATH[index - 1]
        mask |= _direction_bit(cell, prev)
    if index < PATH.size() - 1:
        var nxt: Vector2i = PATH[index + 1]
        mask |= _direction_bit(cell, nxt)
    return mask

func _direction_bit(from_cell: Vector2i, to_cell: Vector2i) -> int:
    var d := to_cell - from_cell
    if d == Vector2i(0, -1): return 1
    if d == Vector2i(1, 0): return 2
    if d == Vector2i(0, 1): return 4
    return 8

func _rotate_mask(mask: int, turns: int = 1) -> int:
    var result := mask
    for _i in range(posmod(turns, 4)):
        var next := 0
        if result & 1: next |= 2
        if result & 2: next |= 4
        if result & 4: next |= 8
        if result & 8: next |= 1
        result = next
    return result

func _rotate_tile(cell: Vector2i, is_echo: bool = false) -> void:
    if game_won or not _inside(cell):
        return
    var tile: Dictionary = board[cell.y][cell.x]
    if not tile["rotatable"]:
        return
    tile["mask"] = _rotate_mask(int(tile["mask"]))
    board[cell.y][cell.x] = tile
    if not is_echo:
        moves += 1
        score = max(0, score + 10)
        # The previous action resolves now, after two player actions.
        if echo_cell.x >= 0:
            echo_countdown -= 1
            if echo_countdown <= 0:
                _apply_echo()
        # This move becomes the next echo. The display previews it.
        echo_cell = cell
        echo_countdown = 2
    _redraw_board()
    _update_labels()
    _check_win()

func _apply_echo() -> void:
    if _inside(echo_cell):
        var tile: Dictionary = board[echo_cell.y][echo_cell.x]
        if tile["rotatable"]:
            tile["mask"] = _rotate_mask(int(tile["mask"]))
            board[echo_cell.y][echo_cell.x] = tile
            status_text.text = "ECHO! Your earlier tile rotated again."
    echo_cell = Vector2i(-1, -1)
    echo_countdown = 0

func _inside(cell: Vector2i) -> bool:
    return cell.x >= 0 and cell.x < BOARD_N and cell.y >= 0 and cell.y < BOARD_N

func _redraw_board() -> void:
    if not is_instance_valid(board_grid):
        return
    for child in board_grid.get_children():
        child.queue_free()
    tile_buttons.clear()
    for y in range(BOARD_N):
        for x in range(BOARD_N):
            var cell := Vector2i(x, y)
            var tile: Dictionary = board[y][x] if y < board.size() and x < board[y].size() else {"kind":"empty", "mask":0}
            var b := Button.new()
            b.custom_minimum_size = Vector2(44, 54)
            b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
            b.size_flags_vertical = Control.SIZE_EXPAND_FILL
            b.focus_mode = Control.FOCUS_NONE
            b.text = _tile_symbol(tile, cell)
            b.add_theme_font_size_override("font_size", 23)
            b.add_theme_color_override("font_color", _tile_color(tile, cell))
            b.add_theme_color_override("font_hover_color", Color.WHITE)
            var style := StyleBoxFlat.new()
            style.bg_color = _tile_bg(tile, cell)
            style.border_color = _tile_border(tile, cell)
            style.set_border_width_all(1)
            style.set_corner_radius_all(12)
            var hover := style.duplicate()
            hover.bg_color = style.bg_color.lightened(0.10)
            var down := style.duplicate()
            down.bg_color = style.bg_color.lightened(0.18)
            b.add_theme_stylebox_override("normal", style)
            b.add_theme_stylebox_override("hover", hover)
            b.add_theme_stylebox_override("pressed", down)
            b.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
            b.disabled = game_won or not bool(tile.get("rotatable", false))
            b.pressed.connect(_on_tile_pressed.bind(cell))
            board_grid.add_child(b)
            tile_buttons.append(b)

func _tile_symbol(tile: Dictionary, cell: Vector2i) -> String:
    var kind: String = tile.get("kind", "empty")
    if kind == "empty":
        return "·"
    if kind == "start":
        return "S"
    if kind == "goal":
        return "G"
    var mask: int = int(tile["mask"])
    if mask == 5: return "↕"
    if mask == 10: return "↔"
    if mask == 3: return "└"
    if mask == 6: return "┌"
    if mask == 12: return "┐"
    if mask == 9: return "┘"
    if mask == 7: return "⊣"
    if mask == 14: return "⊤"
    if mask == 13: return "⊢"
    if mask == 11: return "⊥"
    if mask == 15: return "✦"
    if mask == 1: return "↑"
    if mask == 2: return "→"
    if mask == 4: return "↓"
    if mask == 8: return "←"
    return "◇"

func _tile_color(tile: Dictionary, cell: Vector2i) -> Color:
    if tile.get("kind", "empty") == "empty":
        return Color("#283653")
    if tile.get("kind") == "start":
        return COLORS.green
    if tile.get("kind") == "goal":
        return COLORS.gold
    if cell == echo_cell:
        return COLORS.pink
    return COLORS.cyan

func _tile_bg(tile: Dictionary, cell: Vector2i) -> Color:
    if tile.get("kind", "empty") == "empty":
        return Color("#0d152b")
    if cell == echo_cell:
        return Color("#30152f")
    if tile.get("kind") == "start":
        return Color("#102c32")
    if tile.get("kind") == "goal":
        return Color("#332a1a")
    return Color("#12213b")

func _tile_border(tile: Dictionary, cell: Vector2i) -> Color:
    if cell == echo_cell:
        return COLORS.pink
    if tile.get("kind") == "start":
        return COLORS.green
    if tile.get("kind") == "goal":
        return COLORS.gold
    if tile.get("kind", "empty") == "empty":
        return Color("#172441")
    return Color("#28436b")

func _on_tile_pressed(cell: Vector2i) -> void:
    _rotate_tile(cell)

func _is_connected() -> bool:
    # Flood-fill from START over reciprocal directional connections.
    var start := PATH[0]
    var goal := PATH[PATH.size() - 1]
    var seen: Dictionary = {}
    var queue: Array[Vector2i] = [start]
    seen[start] = true
    while not queue.is_empty():
        var cur: Vector2i = queue.pop_front()
        if cur == goal:
            return true
        var mask: int = int(board[cur.y][cur.x]["mask"])
        var dirs := [
            {"bit": 1, "delta": Vector2i(0, -1), "op": 4},
            {"bit": 2, "delta": Vector2i(1, 0), "op": 8},
            {"bit": 4, "delta": Vector2i(0, 1), "op": 1},
            {"bit": 8, "delta": Vector2i(-1, 0), "op": 2}
        ]
        for d in dirs:
            if (mask & int(d["bit"])) == 0:
                continue
            var nxt: Vector2i = cur + d["delta"]
            if not _inside(nxt) or seen.has(nxt):
                continue
            var next_mask: int = int(board[nxt.y][nxt.x]["mask"])
            if (next_mask & int(d["op"])) != 0:
                seen[nxt] = true
                queue.append(nxt)
    return false

func _check_win() -> void:
    if not _ui_built:
        return
    if _is_connected():
        game_won = true
        score += max(100, 500 - moves * 10)
        best_score = max(best_score, score)
        _save_best()
        status_text.text = "LOOP CONNECTED! Clean logic. Puzzle solved."
        status_text.add_theme_color_override("font_color", COLORS.green)
        next_button.text = "NEXT PUZZLE  →" if current_mode == "LEVELS" else "NEW RUN  →"
        _redraw_board()
        _update_labels()
    else:
        status_text.add_theme_color_override("font_color", COLORS.muted)

func _update_labels() -> void:
    if not _ui_built:
        return
    level_text.text = ("LEVEL %02d" % level) if current_mode == "LEVELS" else "ENDLESS"
    move_text.text = str(moves)
    score_text.text = str(score)
    mode_button.text = current_mode + "  ▾"
    if echo_cell.x >= 0:
        echo_text.text = "Tile %d,%d will echo in %d move(s)." % [echo_cell.x + 1, echo_cell.y + 1, echo_countdown]
    else:
        echo_text.text = "No pending echo. Your next move will start one."
    if game_won:
        echo_text.text = "Loop complete. Ready for the next puzzle."

func _toggle_mode() -> void:
    current_mode = "ENDLESS" if current_mode == "LEVELS" else "LEVELS"
    if current_mode == "LEVELS":
        level = max(1, level)
    else:
        level = 1
    _new_puzzle()

func _next_puzzle() -> void:
    if current_mode == "LEVELS":
        if game_won:
            level += 1
        else:
            level += 1
    else:
        level += 1
    _new_puzzle()

func _save_best() -> void:
    var file := FileAccess.open("user://loop_save.cfg", FileAccess.WRITE)
    if file:
        file.store_32(best_score)

func _load_best() -> void:
    if FileAccess.file_exists("user://loop_save.cfg"):
        var file := FileAccess.open("user://loop_save.cfg", FileAccess.READ)
        if file:
